<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👻 Soul (System Prompt)"
        android:textSize="24sp"
        android:textColor="#B388FF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This prompt will be injected into every LLM request"
        android:textColor="#B388FF"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <EditText android:id="@+id/etSoul"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Enter your soul prompt here..."
        android:gravity="top"
        android:background="#1E1E2E"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

    <Button android:id="@+id/btnSaveSoul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 Save Soul"
        android:layout_marginTop="12dp" />
</LinearLayout>
