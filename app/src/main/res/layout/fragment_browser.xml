<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#311B92">

        <ImageButton android:id="@+id/btnBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous" />

        <Button android:id="@+id/btnMode"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Search"
            android:textSize="10sp"
            android:padding="4dp" />

        <Spinner android:id="@+id/spinnerSearch"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="#7C4DFF" />

        <EditText android:id="@+id/urlInput"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search or URL"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#B388FF" />

        <ImageButton android:id="@+id/btnRefresh"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_popup_sync" />

        <ImageButton android:id="@+id/btnHome"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_compass" />
    </LinearLayout>

    <WebView android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
